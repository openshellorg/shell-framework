# Allow-list: ignore everything, then un-ignore tracked paths.
*
!.gitignore
!LICENSE
!README.md
!CONTRIBUTING.md
!CHANGELOG.md
!package.json
!schemas/
!schemas/**
!pnpm-lock.yaml
!tsconfig.json
!manifests/
!manifests/**
!src/
!src/**
!test/
!test/**
!docs/
!docs/**
!.github/
!.github/**
!/.editorconfig
!/.gitattributes
