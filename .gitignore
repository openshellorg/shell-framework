# Allow-list: ignore everything, then un-ignore tracked paths.
*
!.gitignore
!LICENSE
!README.md
!CONTRIBUTING.md
!CHANGELOG.md
!dub.sdl
!dub.selections.json
!source/
!source/**
!include/
!include/**
!schemas/
!schemas/**
!manifests/
!manifests/**
!test/
!test/**
!docs/
!docs/**
!.github/
!.github/**
!/.editorconfig
!/.gitattributes
